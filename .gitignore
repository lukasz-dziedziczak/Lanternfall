
# ============================================================
# Unreal Engine 5.9 - Git Ignore
# ============================================================

# ------------------------------------------------------------
# Unreal Engine - Generated Files
# ------------------------------------------------------------

/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/

# Plugin-generated files
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/DerivedDataCache/
/Plugins/**/Saved/

# Generated build data
/Build/**/FileOpenOrder/

# ------------------------------------------------------------
# Visual Studio / IDE
# ------------------------------------------------------------

.vs/
.idea/

*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.VC.db-shm
*.VC.db-wal

*.csproj
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Xcode
*.xcodeproj/
*.xcworkspace/

# ------------------------------------------------------------
# Compiled Files
# ------------------------------------------------------------

*.obj
*.o
*.lo
*.slo
*.pch
*.gch

*.pdb
*.ilk
*.idb

# ------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------
# Project Files - KEEP TRACKED
# ------------------------------------------------------------

# The following should remain in Git:
#
# *.uproject
# Config/
# Content/
# Source/
# Build/
# Plugins/ (source, content and descriptors)
# SourceArt/
#
# Do not globally ignore .uasset or .umap files.
# Do not globally ignore .dll or .lib dependencies.
#
# Use Git LFS for large binary game assets.
# ============================================================
